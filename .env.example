# .env.example
# Plantilla de las variables de entorno que necesitan las Netlify Functions
# (netlify/functions/_db.js) para hablar con Turso. NO va con valores reales
# en este archivo — es solo referencia.
#
# En producción (Netlify): Site settings → Environment variables → pegar
# ambos valores ahí. Nunca en un archivo del repo.
#
# En desarrollo local con `netlify dev`: copiar este archivo a `.env`
# (ya está en .gitignore) y completar con los valores reales de tu base.
#
# Cómo obtenerlos (Turso CLI):
#   turso db create agenda-personal
#   turso db show agenda-personal --url            -> TURSO_DATABASE_URL
#   turso db tokens create agenda-personal          -> TURSO_AUTH_TOKEN
# O desde el dashboard: turso.tech -> tu base -> "Connect".

TURSO_DATABASE_URL=libsql://tu-base-tu-org.turso.io
TURSO_AUTH_TOKEN=tu-token-aqui
